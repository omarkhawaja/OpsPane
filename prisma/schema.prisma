// OpsPane — local-first engineering/documentation dashboard.
// See OPSPANE.md at repo root for the full architecture description.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UrlType {
  GITHUB_REPO
  JIRA_BOARD
  JIRA_TICKET
  CONFLUENCE_PAGE
  FILE
  OTHER
}

enum TaskKind {
  REPO_SCAN
  JIRA_STATUS
  CONFLUENCE_SCRAPE
  GENERATE_RELEASE_NOTES
}

enum TaskStatus {
  PENDING
  DONE
  FAILED
}

enum DataSourceKind {
  REAL_DB
  DUMMY
  API
  UNKNOWN
}

enum CommCategory {
  EMAIL
  MESSAGE
  MEETING_TRANSCRIPT
  DOCUMENTATION
  OTHER
}

enum ChangeRequestStatus {
  PENDING
  DONE
}

// The queue the RefPicker pointer tool feeds. Pointing at an element and
// typing an instruction creates one of these instead of (or in addition to)
// just copying a reference to the clipboard, so multiple UI change requests
// can pile up across a session and be handed to Claude Code as one batch —
// via "Copy all pending" on the Change Queue tab — instead of a
// point-copy-paste-describe round trip per element.
model ChangeRequest {
  id          Int                 @id @default(autoincrement())
  ref         String // e.g. "screen:cmabc123" — the data-ops-ref value
  label       String // human-readable, e.g. 'Screen "Dashboard" (acme/legacy-app)'
  instruction String // what the user typed: what should change
  status      ChangeRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  completedAt DateTime?
}

model Url {
  id            String   @id @default(cuid())
  url           String   @unique // for type=FILE, the servable path e.g. /uploads/<cuid>-name.pdf
  type          UrlType
  description   String?
  fileName      String? // original filename, only set when type=FILE
  fileSizeBytes Int? // only set when type=FILE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  repo     Repo?
  features Feature[]
}

model Repo {
  id            String    @id @default(cuid())
  urlId         String    @unique
  url           Url       @relation(fields: [urlId], references: [id], onDelete: Cascade)
  name          String
  summary       String? // high-level app-level description: what it does, overall data sources
  lastScannedAt DateTime?

  screens          Screen[]
  features         Feature[]
  members          Member[]
  communications   Communication[]
  analysisVersions RepoAnalysisVersion[]
}

// An immutable, timestamped snapshot of a repo's analysis — the Repository
// Analyzer tab's version history. `screensJson`/`featuresJson` are frozen
// copies (JSON arrays) taken from the live Screen/ScreenDataSource tables
// (plus a manually/Claude-entered feature list) at the moment the version was
// recorded, so re-running analysis later never overwrites history: it adds a
// new version with versionNumber = previous max + 1. The Repository Comparer
// diffs two of these snapshots (same repo across versions, or two repos)
// by matching screen/feature names as plain strings — no AST diffing.
model RepoAnalysisVersion {
  id            Int      @id @default(autoincrement())
  repoId        String
  repo          Repo     @relation(fields: [repoId], references: [id], onDelete: Cascade)
  versionNumber Int
  summary       String?
  screensJson   String // JSON: [{ name, route, frontend, backend, screenshotUrl, dataSources: [{ kind, label }] }]
  featuresJson  String // JSON: [{ name, description }]
  notes         String? // e.g. "what changed since last version"
  createdAt     DateTime @default(now())

  @@unique([repoId, versionNumber])
}

// Pasted-in emails, chat messages, meeting transcripts, or generic docs.
// `id` is a sequential integer (not a cuid, unlike every other model here) on
// purpose: it's the stable, human-referenceable handle for a communication —
// shown in the UI as "C-{id}" — so you (or Claude) can point at "C-14"
// unambiguously instead of a long opaque string.
model Communication {
  id        Int          @id @default(autoincrement())
  category  CommCategory
  title     String?
  source    String? // e.g. "jane.doe@acme.com", "Sprint planning 2026-10-14"
  content   String
  repoId    String?
  repo      Repo?        @relation(fields: [repoId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Member {
  id        String  @id @default(cuid())
  firstName String
  lastName  String
  email     String
  role      String?
  notes     String?
  repoId    String?
  repo      Repo?   @relation(fields: [repoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Screen {
  id            String   @id @default(cuid())
  repoId        String
  repo          Repo     @relation(fields: [repoId], references: [id], onDelete: Cascade)
  name          String
  route         String? // e.g. /dashboard/settings
  frontend      String? // JSON-stringified list of front-end components
  backend       String? // JSON-stringified list of back-end components/endpoints
  screenshotUrl String? // servable path under public/uploads/, e.g. /uploads/<uuid>-dashboard.png
  notes         String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dataSources ScreenDataSource[]
  outgoing    ScreenTransition[] @relation("fromScreen")
  incoming    ScreenTransition[] @relation("toScreen")
}

model ScreenDataSource {
  id       String         @id @default(cuid())
  screenId String
  screen   Screen         @relation(fields: [screenId], references: [id], onDelete: Cascade)
  kind     DataSourceKind @default(UNKNOWN)
  label    String // e.g. "Postgres: users table", "Pinecone index: docs", "dummy fixture data"
}

model ScreenTransition {
  id           String  @id @default(cuid())
  repoId       String
  fromScreenId String
  fromScreen   Screen  @relation("fromScreen", fields: [fromScreenId], references: [id], onDelete: Cascade)
  toScreenId   String
  toScreen     Screen  @relation("toScreen", fields: [toScreenId], references: [id], onDelete: Cascade)
  trigger      String? // e.g. "click Save button"
}

model Feature {
  id            String    @id @default(cuid())
  name          String
  repoId        String?
  repo          Repo?     @relation(fields: [repoId], references: [id], onDelete: SetNull)
  jiraUrlId     String?
  jiraUrl       Url?      @relation(fields: [jiraUrlId], references: [id], onDelete: SetNull)
  status        String? // raw Jira status/column, cached
  completionPct Int? // 0-100, derived from status, cached
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// A reusable, copy-pasteable prompt for the Commands tab — the exact text
// you paste into a Claude Code session to make it do something (e.g. drain
// the Task queue). Seeded with a handful of defaults the first time the
// Commands tab is opened with an empty table; fully editable after that.
model Command {
  id          String   @id @default(cuid())
  label       String
  command     String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One entry per shipped change, shown on the What's New tab (last in the
// nav). `commitSha` is captured from `git rev-parse HEAD` at the moment the
// entry is recorded, if the working directory is a git repo — that's the
// actual rollback mechanism ("git checkout <commitSha>"); this table is a
// human-readable index into git history, not a snapshot of app state itself.
model Release {
  id        Int      @id @default(autoincrement())
  version   String // e.g. "0.3.0"
  title     String
  notes     String // markdown-ish bullet list of what shipped
  commitSha String?
  createdAt DateTime @default(now())
}

// Task queue for the "Claude-Code-driven" refresh model: clicking a Refresh
// button in the UI just creates a PENDING row here. A Claude Code session
// picks up pending tasks, does the real work (reading the repo, calling the
// Jira/Confluence MCP), and marks the task DONE after writing results back
// into the tables above. Nothing here calls an external API automatically.
model Task {
  id          String     @id @default(cuid())
  kind        TaskKind
  targetId    String // id of the Repo, Feature, or Url this task is about
  status      TaskStatus @default(PENDING)
  requestedAt DateTime   @default(now())
  completedAt DateTime?
  notes       String?
}
